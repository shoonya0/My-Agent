# Copy to config.env and fill in secrets. Never commit config.env.
#
# Docker Compose (docker-compose.yml) overrides connectivity via the `environment`
# block on each app service (MySQL, Redis, Kafka, Jaeger, MinIO, auth gRPC). You
# still must set real secrets here: OPENAI_API_KEY, JWT_SECRET, ENCRYPTION_KEY.
#
# Published ports (main compose): api-gateway 8080, auth gRPC 9090, auth HTTP 8082,
# orchestrator 9091, approval-service (HTTP/WS) 8086, MySQL 3306, Redis 6379,
# Kafka 9092, MinIO S3 9000 / console 9001, Jaeger UI 16686, Prometheus UI 9095,
# Grafana 3000 (admin / admin_change_me).

# ---------------------------------------------------------------------------
# Shared (all services that call config.Load())
# ---------------------------------------------------------------------------
LOG_LEVEL=info

MYSQL_DSN=myagent:myagent@tcp(localhost:3306)/myagent?parseTime=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me-to-a-long-random-string

KAFKA_BROKERS=localhost:9092

OPENAI_API_KEY=sk-your-openai-key
ORCHESTRATOR_MODEL=gpt-4o
PROMPT_AGENT_MODEL=gpt-4o
PROMPT_AGENT_SYSTEM_PROMPT=

COMFYUI_BASE_URL=http://localhost:8188

AWS_BUCKET=myagent
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

JAEGER_ENDPOINT=localhost:4317

# 64 hex characters (32 bytes) for AES-256-GCM credential encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# gRPC / HTTP ports (defaults match pkg/types config; Docker Compose sets service-specific overrides)
# ---------------------------------------------------------------------------
GRPC_PORT=9090
AUTH_SERVICE_ADDR=localhost:9090
AUTH_SERVICE_PORT=8082

API_GATEWAY_PORT=8080
ORCHESTRATOR_PORT=9091
PROMPT_AGENT_PORT=8084
IMAGE_GEN_AGENT_PORT=8085
APPROVAL_SERVICE_PORT=8086
DISTRIBUTION_PORT=8087

API_SERVICE_NAME=api-gateway
AUTH_SERVICE_NAME=auth-service
ORCHESTRATOR_SERVICE_NAME=orchestrator
PROMPT_AGENT_SERVICE_NAME=prompt-agent
IMAGE_GEN_AGENT_SERVICE_NAME=image-gen-agent
APPROVAL_SERVICE_NAME=approval-service
DISTRIBUTION_SERVICE_NAME=distribution-service

# ---------------------------------------------------------------------------
# Optional platform connectors (distribution-service)
# ---------------------------------------------------------------------------
INSTAGRAM_TOKEN=
WHATSAPP_TOKEN=
DISCORD_WEBHOOK=
TELEGRAM_TOKEN=

# ---------------------------------------------------------------------------
# Optional: override config file path (Viper)
# ---------------------------------------------------------------------------
# CONFIG_PATH=/absolute/path/to/config.env
